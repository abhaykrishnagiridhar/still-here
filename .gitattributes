# Store text files with Unix line endings and check them out the same way, so every machine
# (and the generated .js files) agree and git stops printing line-ending warnings.
* text=auto eol=lf

# Never touch these.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.zip binary
*.pdf binary
*.ico binary
*.woff binary
*.woff2 binary
*.avi binary
*.mp4 binary
